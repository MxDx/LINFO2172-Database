/* List the name of all the mountains in the database. */
Mountain{name}

/* List the codes of the countries with more than 10.000 cases of COVID-19 in March 2021. */
WITH(
    C:= CountryCovid{country, total_cases, year, month} WHERE total_cases > 10000 AND year = 2021 AND month = 3
): C{country}

/* List all provinces in Europe whose area is less than 200. The results must be a relation composed of 2-tuples 
 with attributes {province, country}, corresponding to the full province name and the full country name, respectively. */
WITH(
    E:= (Encompasses{country, continent} WHERE continent = "Europe"){country},
    P:= (E JOIN Province{name,country,area}) RENAME {name AS province},
    R:= (P{province, country, area} WHERE area < 200.0){country, province},
    RR:= R RENAME {country AS code},
    C:= Country{name, code} RENAME {name AS country} 
): (RR JOIN C){province, country}

/* List all countries in Europe whose total number of deaths in December 2022 exceeded 10.000. The result must be a 
relation composed of 3-tuples with attributes {country, population, total_deaths}, corresponding to the full country name, 
its population, and its number of deaths respectively. */
WITH(
    E:= (Encompasses{country, continent} WHERE continent = "Europe"){country},
    ER:= E{country} RENAME {country AS code},
    C:= (CountryCovid{country, total_deaths, year, month} WHERE year = 2022 AND month = 12 AND total_deaths > 10000){country, total_deaths},
    CR:= C{country, total_deaths} RENAME {country AS code},
    P:= Country{code, population, name} RENAME {name AS country}
): (ER JOIN CR JOIN P){country, population, total_deaths}

/* For each country that has declared independence, give its full name and its independence date. */
WITH(
    C:= Country{code, name} RENAME { code AS country },
    I:= Independence{country, independence}
): (C JOIN I){name, independence}

/* List country codes and full names of countries that share borders with both countries China and India. 
 * The result relation is composed of 2-tuples with attributes {code, name}. */
WITH(
    BC:= (Borders{country1, country2} WHERE country2 = "TJ"){country1} RENAME { country1 AS code },
    BI:= (Borders{country1, country2} WHERE country2 = "IND"){country1} RENAME { country1 AS code},
    B:= BC INTERSECT BI,
    C:= Country{code, name}
):  (B JOIN C){code, name}

/* List the capitals of countries who possess a mountain of height strictly superior to 4.000, where the mountain is located in the Alps.  
* The result must be a relation composed of 1-tuples with attribute {capital}. */
WITH(
    M:= (Mountain{name, mountains, height} WHERE height > 4000.0 AND mountains = "Alps"){name},
    CM:= ((GeoMountain{mountain, country} RENAME {mountain as name, country as code}) JOIN M) {code},
    C:= (Country{code, capital} JOIN CM){capital}
): C 

/* List the codes and names of the countries without information about their languages. */ 
WITH(
    L:= (Language {country}) RENAME {country as code},
    C:= (Country {name, code})
): (C{code} MINUS L) JOIN C

/* List the mountain ranges (as defined by the attribute mountains in Table Mountain) in which there is a mountain that stands on at least two countries. 
 * For example, Alps is a mountain range and it hosts the mountain Mont Blanc on the border of France and Italy. */ 
WITH(
    R:= (SUMMARIZE GeoMountain{mountain, country} BY {mountain}: {mcount := COUNT()} WHERE mcount >= 2){mountain},
    M:= Mountain{name, mountains} RENAME {name AS mountain}
): ((R INTERSECT M{mountain}) JOIN M){mountains}

/* List all names shared by a province and a country’s capital whose country had reached strictly more than 10000 Covid deaths at some point in time,
 * as determined by attribute total_death in the CountryCovid table. Note that the total_death attribute stores the total number of deaths up till a certain moment in time. 
 * The relationship is called name. */ 
WITH(
    N:= (Province{name, country, capital}){country, name},
    CV:= (CountryCovid{total_deaths, country} WHERE total_deaths > 10000){country, total_deaths},
    C:= Country{code, capital} RENAME {code AS country},
    R:= (C JOIN CV{country} JOIN N){name, capital}
):  (R WHERE capital = name){name}

/* List the full names of the countries that border the United States, as well as the countries that border those bordering countries. I.e.,
 * the output should contain Mexico, but also Belize, which borders Mexico. The United States itself should not be part of the output. */
WITH(
    B:= Borders{country1, country2},
    BUSA:= (B WHERE country2 = "USA"),
    BNOUSA:= (B MINUS BUSA),
    BB:= (BUSA{country1} JOIN BNOUSA){country2} RENAME {country2 AS country1},
    R:= (BB UNION BUSA{country1})RENAME {country1 AS code},
    C:= Country{code, name}
): (R JOIN C){name}

/* Count the number of different countries whose Covid information was collected. The result must be a relation composed of 1-tuples with attribute {cnt}. */ 
WITH(
    C:= (CountryCovid{country}){country},
    R:= SUMMARIZE C BY {}: {cnt := COUNT()}
): R

/* List the name of all countries which have zero Covid cases until 12/2021 (included) and their neighboring countries. The result must be a relation composed of tuples of 2 attributes {country1, country2}
 * where the country1 is the zero-Covid country and country2 is its neighboring country. Note that also if no information is present in the database for a country, 
 * this country and its neighbors should be included in the output relation. */
WITH(
    CV:= CountryCovid{country, total_cases, year, month},
	CF:= CV WHERE total_cases = 0 AND year <= 2021 AND month <= 12,
	C:= Country{code, name} RENAME {code AS country},
	CM:= C{country} MINUS CV{country},
	R:= (CF JOIN CM) RENAME {country AS country1},
    B:= Borders{country1, country2}
): (C JOIN B){country1, country2}

/* List the most prominent language(s) for each country; i.e., list for each country those languages for which the percentage is maximal. 
 * You are not allowed to use SUMMARIZE. The result must be a relation composed of 2-tuples with attributes {country, name}, 
 * where country is the code of the country and name is the name of the language. */
WITH(
    L:= Language{country, name, percentage},
    R:= (L JOIN (SELECT Language{country, MAX(percentage) AS percentage} GROUP BY {country}){country, percentage}){country, name}
): R

/* In the given database the Borders relation is symmetric":" if the country 1 (c1) borders country 2 (c2), country 2 also borders country 1. 
 * One may wish to check this property on a given database. Write a query that determines all tuples {c1, c2}, 
 * where c1 and c2 are the codes of the countries, for which the inverse direction is missing. 
 * (Note":" on the given database, the output of this query should be empty; on a database in which the Border relation is not symmetric, 
 * however, it should return the violating tuples. Create a database yourself to check this.) */
WITH(
    INSERT Test RELATION { TUPLE { country1 'AL', country2 'GR'} };
    INSERT Test RELATION { TUPLE { country1 'GR', country2 'AL'} };
    INSERT Test RELATION { TUPLE { country1 'AL', country2 'MK'} };
): 

WITH(
    B:= Borders{country1, country2},
    BINV:= (B{country2, country1} RENAME {country1 AS country2, country2 AS country1}){country1, country2},
    R:= (B MINUS BINV){country1, country2}
): R
